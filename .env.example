# Admin password for /admin.html
# Choose a strong password and keep this secret.
ORYX_ADMIN_PASSWORD=

# Required on Vercel (signs the admin session cookie)
# Generate a long random string (32+ chars).
ORYX_ADMIN_TOKEN_SECRET=

# Vercel Blob (required for /api/upload)
# Create a Blob store and set BLOB_READ_WRITE_TOKEN in your Vercel project.
BLOB_READ_WRITE_TOKEN=

# Vercel KV / Upstash (required for saving content)
# These are normally injected automatically when you add the KV/Upstash integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=
